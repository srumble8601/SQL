-- Create a view to display customer first,last names
-- total number of invoices & total amt spent
CREATE VIEW View_CustomerInvoices AS
SELECT CONCAT(c.FirstName, ' ', c.LastName) AS CustomerName,
       COUNT(i.InvoiceID) AS NbrOfInvoices,
       SUM(i.Total) AS TotalAmtSpent
FROM Customer c 
JOIN Invoice i ON c.CustomerId = i.CustomerId
GROUP BY c.FirstName, c.LastName;
